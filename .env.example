# ===== 必填 =====
# 网站登录密钥，只此一项，无用户名。建议至少 16 位随机字符串。
ACCESS_KEY=change-me-to-a-long-random-key

# 会话签名与 B 站会话加密密钥。至少 32 字符，修改后已有会话与 B 站登录态会失效。
SESSION_SECRET=replace-with-at-least-32-random-characters

# ===== 可选 =====
# B 站 Cookie 兜底（可留空）。网页扫码登录保存的会话优先。
# 例：SESSDATA=xxx; bili_jct=xxx; buvid3=xxx
BILI_COOKIE=

# Cookie 续期检查间隔，默认 6 小时。
BILI_REFRESH_CHECK_MS=21600000

# HTTP 端口。
PORT=3000

# 同时监控的直播间上限。
MAX_ROOMS=10

# 网站会话有效期（天）。
SESSION_DAYS=7

# 通过 HTTPS 反向代理访问时设为 true，会话 Cookie 会带 Secure。
COOKIE_SECURE=false
